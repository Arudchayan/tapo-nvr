# Copy this file to `.env` and adjust the values.
# Full reference: docs/configuration.md. Never commit the completed file.

# --- Camera (reachable from the relay host) ---
CAMERA_HOST=192.168.1.50
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=camera-account
CAMERA_PASSWORD=change-me
# Tapo cloud account password (not the Camera Account password). Only needed
# for `tapo-nvr sync`, which downloads the camera's SD-card recordings.
CAMERA_CLOUD_PASSWORD=
CAMERA_RECORD_STREAM=stream1
CAMERA_DETECT_STREAM=stream2
CAMERA_DETECT_WIDTH=640
CAMERA_DETECT_HEIGHT=360
CAMERA_DETECT_FPS=5
CAMERA_OBJECTS=person,cat,dog

# --- Relay host ---
# `auto` resolves the Tailscale IPv4 address with `tailscale ip -4`.
RELAY_HOST=auto
RELAY_PORT=8554
RELAY_ALLOWED_CIDR=100.64.0.0/10

# --- NVR host (reached over SSH by `tapo-nvr deploy` / `inspect`) ---
NVR_HOST=nvr-host.your-tailnet.ts.net
NVR_SSH_PORT=22
NVR_SSH_USER=nvr-admin
# Prefer a key. When empty, NVR_SSH_PASSWORD is used instead.
NVR_SSH_KEY=
NVR_SSH_PASSWORD=
# true requires an entry in known_hosts. Set to false only for initial setup.
NVR_STRICT_HOST_KEY_CHECKING=true
NVR_BASE_PATH=~/tapo-nvr

# --- Frigate ---
FRIGATE_CONTAINER_NAME=tapo-frigate
FRIGATE_CAMERA_NAME=tapo_c220
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:stable
FRIGATE_UI_PORT=8971
# auto | vaapi | none
FRIGATE_GPU=auto
FRIGATE_SHM_SIZE=64m
# Leave empty for $NVR_BASE_PATH/frigate/storage.
FRIGATE_STORAGE_PATH=
RETENTION_DAYS=30
MOTION_RETENTION_DAYS=3

# --- SD-card backup (`tapo-nvr sync`) ---
# Where downloaded clips are written. Point this at a Google Drive folder for
# offsite backup. `--output` overrides it.
SYNC_OUTPUT_DIR=

# --- Laptop recording (`tapo-nvr record`) ---
# Local staging directory. Keep this off the Google Drive mount; finished
# segments are copied to RECORD_OUTPUT_DIR.
RECORD_STAGING_DIR=
# Publish directory. Empty uses ./recordings/record. Keep it separate from
# SYNC_OUTPUT_DIR so recorder retention cannot delete sync clips.
RECORD_OUTPUT_DIR=
# Segment length in seconds (1800 = 30 minutes).
RECORD_SEGMENT_SECONDS=1800
# Hours to keep a published segment locally before deleting it.
RECORD_KEEP_HOURS=24
# Delete published files older than this many days from RECORD_OUTPUT_DIR.
# 0 keeps everything. Use 7 for 2K continuous recording.
RECORD_OUTPUT_KEEP_DAYS=0
# Stop recording before this much space is left on the staging disk.
RECORD_MIN_FREE_GB=10
# Restart ffmpeg after this many seconds without a growing segment (0 disables).
RECORD_STALL_SECONDS=300
# Optional overrides; empty defaults to <RECORD_STAGING_DIR>/record.log and status.json.
RECORD_LOG_FILE=
RECORD_STATUS_FILE=

# --- Windows service scripts only ---
# PYTHON_PATH=C:\Python312\python.exe
