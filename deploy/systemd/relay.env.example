# Environment file for deploy/systemd/tapo-nvr-relay.service.
# Install as /etc/tapo-nvr/relay.env with mode 0644 (it contains no secrets)
# and run: sudo systemctl restart tapo-nvr-relay

# Camera on the relay host's LAN.
CAMERA_HOST=192.168.1.50
CAMERA_RTSP_PORT=554

# Relay listener. RELAY_HOST=auto resolves the Tailscale IPv4 address at start.
RELAY_HOST=auto
RELAY_PORT=8554
RELAY_ALLOWED_CIDR=100.64.0.0/10
