# Environment file for deploy/systemd/tapo-nvr-relay.service.
# Install as /etc/tapo-nvr/relay.env and run:
#   sudo systemctl daemon-reload && sudo systemctl restart tapo-nvr-relay

# Camera on the relay host's LAN.
CAMERA_HOST=192.168.1.50
CAMERA_RTSP_PORT=554

# Relay listener. RELAY_HOST=auto resolves the Tailscale IPv4 address at start.
RELAY_HOST=auto
RELAY_PORT=8554
RELAY_ALLOWED_CIDR=100.64.0.0/10

# Python interpreter that can import tapo_nvr. Set this when the package is
# installed in a virtual environment, for example:
#   PYTHON=/opt/tapo-nvr/venv/bin/python3
# PYTHON=/usr/bin/python3
